# Clerk - Dashboard > API Keys (https://dashboard.clerk.com)
# Publishable key - exposed to the client, required by Clerk's SDK under this exact name
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret key - server-side only, never expose to the client
CLERK_SECRET_KEY=
# Webhook signing secret - Dashboard > Webhooks > your endpoint > Signing Secret
# Used to verify /api/users/sync requests actually came from Clerk
CLERK_WEBHOOK_SECRET=

# MongoDB Atlas connection string - Atlas > Database > Connect > Drivers
# Include the database name in the path, e.g. mongodb+srv://user:pass@cluster.mongodb.net/pantry
MONGODB_URI=

# Google AI Studio API key (https://aistudio.google.com/apikey)
# Used by the Vercel AI SDK's @ai-sdk/google provider for all Gemini calls
GEMINI_API_KEY=
